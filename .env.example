# Токен бота от @BotFather (обязательно)
TELEGRAM_BOT_TOKEN=123456789:AAAA...

# chat_id получателя. Если не задан — сервис при старте ждёт, пока
# пользователь TARGET_TG_USERNAME напишет боту /start, и определит его сам.
# TELEGRAM_CHAT_ID=

# Ник пользователя Telegram, чьи сообщения принимаются при автоопределении chat_id
TARGET_TG_USERNAME=black_mug

# Интервал проверки в секундах (по умолчанию 1800 = 30 минут)
# POLL_INTERVAL_S=1800

# Максимум страниц на один поиск за цикл (по 20 объявлений)
# MAX_PAGES=10

# Пауза между запросами страниц, секунды
# PAGE_DELAY_S=2.5

# --- Хранение состояния в GitHub Gist (для GitHub Actions / эфемерных раннеров) ---
# Если заданы GIST_ID и GIST_TOKEN, состояние читается/пишется в gist,
# а не в локальный файл (локальный файл остаётся как временная копия).
# GIST_ID=<id приватного gist>
# GIST_TOKEN=<PAT с правом gist>
# GIST_FILENAME=krisha-state.json
